# =============================================================================
# CellMap BioAnalytics — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# ---- Application ----
APP_NAME=CellMap BioAnalytics
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_PREFIX=/api/v1

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cellmap
POSTGRES_USER=cellmap
POSTGRES_PASSWORD=cellmap_secret_change_me

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---- JWT ----
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File Storage ----
UPLOAD_DIR=/app/data/uploads
RESULTS_DIR=/app/data/results
MAX_UPLOAD_SIZE_MB=500

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Admin ----
ADMIN_EMAIL=admin@cellmap.bio
ADMIN_PASSWORD=admin_change_me

# ---- Logging ----
LOG_LEVEL=INFO
